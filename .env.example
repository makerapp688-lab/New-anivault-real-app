# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Session & Authentication Configuration (set in runtime environment; never commit real secrets)
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=
OWNER_USERNAME=
OWNER_PASSWORD=
# Optional: only needed if you prefer pre-computed PBKDF2 hash/salt instead of OWNER_PASSWORD
OWNER_PASSWORD_HASH=
OWNER_PASSWORD_SALT=
